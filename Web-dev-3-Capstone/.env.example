# Server Configuration
NODE_ENV=development
PORT=5000

# MongoDB Connection
MONGODB_URI=mongodb://127.0.0.1:27017/krmu_campus_db

# JWT Secrets & Expiries (Replace with strong random strings in production)
JWT_ACCESS_SECRET=replace_with_strong_access_secret_key
JWT_REFRESH_SECRET=replace_with_strong_refresh_secret_key
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Academic Configuration
LOW_ATTENDANCE_THRESHOLD=75
CORS_ORIGIN=*
